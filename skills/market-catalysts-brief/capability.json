{
  "schema_version": 1,
  "skill": "market-catalysts-brief",
  "delivery": "markdown_brief",
  "default_market": {
    "when_unspecified": "US equities",
    "currency": "USD",
    "timezone": "America/New_York",
    "user_timezone_does_not_select_market": true,
    "explicit_market_overrides": true,
    "default_daily_window": "next 7 calendar days"
  },
  "response_fields": [
    "research_as_of",
    "scheduled_events",
    "developing_risks",
    "data_gap"
  ],
  "forbidden_effects": [
    "account_access",
    "broker_write",
    "drive_write"
  ],
  "fixture_validation": {
    "renderer": "scripts/render_market_catalysts_fixture.py",
    "artifact": "research-brief.md",
    "required_markers": [
      "# 市场催化剂简报",
      "研究时间：",
      "## 已定事件",
      "## 发展中风险",
      "- 来源：",
      "- 来源时间：",
      "## 数据缺口"
    ]
  },
  "scenarios": [
    {
      "request": "整理下周美股需要关注的宏观、财报和地缘政治催化剂。",
      "fixture": "tests/fixtures/market-catalysts-brief.json",
      "expected": {
        "research_as_of": "2026-07-26T09:00:00-04:00",
        "scheduled_events": "included",
        "developing_risks": "included",
        "data_gap": "included"
      }
    }
  ]
}
