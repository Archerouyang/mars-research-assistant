{
  "schema_version": "1.0",
  "contract_version": "macro-v1",
  "question": "当前金融条件是否支持增加高 Beta 风险，以及未来一周哪些事件可能改变这个判断？",
  "allowed_statuses": [
    "available",
    "stale",
    "missing",
    "unsupported",
    "source_error",
    "conflicted"
  ],
  "freshness_policies": {
    "completed_market": "must_equal_the_most_recent_common_completed_close_or_settlement_date",
    "official_release": "must_use_the_latest_officially_published_observation_and_preserve_its_reference_period",
    "event": "future_event_time_and_required_metadata_are_refreshed_every_run",
    "policy": "executive_policy_evidence_is_refreshed_within_24_hours"
  },
  "fields": [
    {"field_id":"rates.us_2y_yield","decision_purpose":"区分近期政策预期。","unit":"percent","timing":"official_release","source_routes":[{"source_id":"us_treasury","method":"official_daily_curve"}]},
    {"field_id":"rates.us_10y_yield","decision_purpose":"衡量成长资产折现率。","unit":"percent","timing":"official_release","source_routes":[{"source_id":"us_treasury","method":"official_daily_curve"}]},
    {"field_id":"rates.us_30y_yield","decision_purpose":"衡量期限溢价与长期供给压力。","unit":"percent","timing":"official_release","source_routes":[{"source_id":"us_treasury","method":"official_daily_curve"}]},
    {"field_id":"credit.hyg_close","decision_purpose":"保留高收益信用原始收盘。","unit":"usd","timing":"completed_market","source_routes":[{"source_id":"configured_broker","method":"daily_close"},{"source_id":"qualified_market_source","method":"daily_close"}]},
    {"field_id":"credit.lqd_close","decision_purpose":"保留投资级信用原始收盘。","unit":"usd","timing":"completed_market","source_routes":[{"source_id":"configured_broker","method":"daily_close"},{"source_id":"qualified_market_source","method":"daily_close"}]},
    {"field_id":"credit.hyg_lqd_ratio","decision_purpose":"识别信用风险偏好相对变化。","unit":"ratio","timing":"completed_market","derivation_inputs":["credit.hyg_close","credit.lqd_close"],"formula":"credit.hyg_close / credit.lqd_close","source_routes":[{"source_id":"derived","method":"deterministic_formula"}]},
    {"field_id":"volatility.vix_close","decision_purpose":"保留短端隐含波动率。","unit":"volatility_index_points","timing":"completed_market","source_routes":[{"source_id":"cboe_daily_index_history","method":"official_csv"}]},
    {"field_id":"volatility.vix3m_close","decision_purpose":"保留三个月隐含波动率。","unit":"volatility_index_points","timing":"completed_market","forbidden_substitutes":["VIXM","VIXY","UVXY","SVXY"],"source_routes":[{"source_id":"cboe_daily_index_history","method":"official_csv"}]},
    {"field_id":"volatility.vix_vix3m_ratio","decision_purpose":"识别波动率期限结构。","unit":"ratio","timing":"completed_market","derivation_inputs":["volatility.vix_close","volatility.vix3m_close"],"formula":"volatility.vix_close / volatility.vix3m_close","source_routes":[{"source_id":"derived","method":"deterministic_formula"}]},
    {"field_id":"equity.spx_close","decision_purpose":"保留美国大盘基准收盘。","unit":"index_points","timing":"completed_market","source_routes":[{"source_id":"configured_broker","method":"daily_close"},{"source_id":"qualified_index_source","method":"daily_close"}]},
    {"field_id":"equity.ndx_close","decision_purpose":"保留大型成长基准收盘。","unit":"index_points","timing":"completed_market","source_routes":[{"source_id":"configured_broker","method":"daily_close"},{"source_id":"qualified_index_source","method":"daily_close"}]},
    {"field_id":"equity.rut_close","decision_purpose":"保留精确小盘指数收盘。","unit":"index_points","timing":"completed_market","forbidden_substitutes":["IWM"],"source_routes":[{"source_id":"cboe_daily_index_history","method":"official_csv"}]},
    {"field_id":"equity.ndx_rut_ratio","decision_purpose":"衡量大型成长相对小盘强弱。","unit":"ratio","timing":"completed_market","change_windows":[1,5,20],"derivation_inputs":["equity.ndx_close","equity.rut_close"],"formula":"equity.ndx_close / equity.rut_close","source_routes":[{"source_id":"derived","method":"deterministic_formula"}]},
    {"field_id":"equity.ndx_rut_normalized_20d","decision_purpose":"解释 NDX/RUT 的二十日标准化趋势。","unit":"z_score","timing":"completed_market","derivation_inputs":["equity.ndx_rut_ratio"],"formula":"(ratio - mean_20d) / stddev_20d","source_routes":[{"source_id":"derived","method":"deterministic_formula"}]},
    {"field_id":"liquidity.reserve_balances","decision_purpose":"单独观察银行准备金。","unit":"usd_billions","timing":"official_release","source_routes":[{"source_id":"federal_reserve_h41","method":"official_release"}]},
    {"field_id":"liquidity.tga_balance","decision_purpose":"单独观察财政部一般账户。","unit":"usd_billions","timing":"official_release","source_routes":[{"source_id":"us_treasury_operating_cash","method":"official_release"}]},
    {"field_id":"liquidity.on_rrp_usage","decision_purpose":"单独观察隔夜逆回购使用量。","unit":"usd_billions","timing":"official_release","source_routes":[{"source_id":"new_york_fed","method":"official_release"}]},
    {"field_id":"events.seven_day_allowlist","decision_purpose":"列出未来七日足以改变风险判断的事件。","unit":"event_set","timing":"event","source_routes":[{"source_id":"official_event_calendars","method":"official_release_calendar"}]},
    {"field_id":"policy.us_executive_actions","decision_purpose":"识别特朗普及美国行政政策的可验证冲击。","unit":"policy_evidence_set","timing":"policy","source_routes":[{"source_id":"official_us_policy_sources","method":"official_action_or_attributable_statement"}]}
  ]
}
