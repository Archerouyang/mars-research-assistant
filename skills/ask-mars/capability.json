{
  "schema_version": 1,
  "skill": "ask-mars",
  "delivery": "recommendation",
  "response_fields": [
    "recommended_skills",
    "first_step",
    "minimum_input"
  ],
  "forbidden_effects": [
    "research",
    "market_data",
    "drive_write"
  ],
  "scenarios": [
    {
      "request": "帮我准备下周美股事件，并研究 NVDA。",
      "expected": {
        "recommended_skills": [
          "市场催化剂简报",
          "标的研究"
        ],
        "sequence": [
          "市场催化剂简报",
          "标的研究"
        ],
        "first_step": "市场催化剂简报",
        "minimum_input": [
          "目标市场",
          "研究时间范围"
        ]
      }
    },
    {
      "request": "分析 NVDA 日线趋势、关键位并给我一张可审计图表。",
      "expected": {
        "recommended_skills": [
          "技术面分析"
        ],
        "first_step": "技术面分析",
        "minimum_input": [
          "标的",
          "新的 output_dir"
        ]
      }
    }
  ]
}
