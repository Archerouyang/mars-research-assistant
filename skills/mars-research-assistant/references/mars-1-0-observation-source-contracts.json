{
  "schema_version": "1.0",
  "contract_version": "mars-observation-adapter-v1",
  "scope": "Mars 1.0 direct-source raw observations only",
  "safety": {
    "adapter_may_call_network": false,
    "persist_raw_source_payloads": false,
    "allowed_fixture_content": "deterministic_synthetic_source_payloads_only",
    "caller_derived_values_allowed": false,
    "broker_runtime_assumptions_allowed": false,
    "partial_board_allowed": false,
    "actual_latest_completed_market_session_required": true,
    "actual_latest_official_observation_required": true
  },
  "source_evidence": [
    {
      "id": "treasury-daily-yield-xml-feed",
      "authority": "U.S. Department of the Treasury",
      "url": "https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "The official Daily Treasury Rates page exposes the exact 2Y, 10Y, and 30Y par-yield columns in a directly readable table."
    },
    {
      "id": "cboe-vix-historical-data",
      "authority": "Cboe",
      "url": "https://www.cboe.com/tradable_products/vix/vix_historical_data",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "Cboe publishes updated-daily VIX closing-value history from 1990 to present."
    },
    {
      "id": "cboe-rut-vix3m-exact-history",
      "authority": "Cboe",
      "url": "https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX3M_History.csv",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "The existing exact-source audit directly opened the Cboe VIX3M and RUT daily-history maps; this adapter reuses their exact URLs and columns."
    },
    {
      "id": "fred-nasdaq100-daily-close",
      "authority": "Federal Reserve Bank of St. Louis / Nasdaq, Inc.",
      "url": "https://fred.stlouisfed.org/series/NASDAQ100",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "FRED identifies NASDAQ100 as Nasdaq Daily Index Data, Daily, Close, and displays the exact latest daily observation.",
      "use_constraint": "The page marks the series Copyrighted: Pre-Approval Required. This repository keeps only synthetic fixtures; any future live/private use must independently satisfy FRED and Nasdaq terms and preserve attribution."
    },
    {
      "id": "nyse-hours-calendars",
      "authority": "NYSE",
      "url": "https://www.nyse.com/markets/hours-calendars",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "NYSE publishes the U.S. equities trading-hours and holiday calendar used to establish the latest completed market session."
    },
    {
      "id": "federal-reserve-h41",
      "authority": "Federal Reserve Board",
      "url": "https://www.federalreserve.gov/releases/h41/",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "H.4.1 is the Board release for factors affecting reserve balances."
    },
    {
      "id": "treasury-daily-statement-operating-cash",
      "authority": "U.S. Treasury Bureau of the Fiscal Service",
      "url": "https://fiscaldata.treasury.gov/datasets/daily-treasury-statement/operating-cash-balance",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "The Daily Treasury Statement reports the Treasury General Account operating-cash balance."
    },
    {
      "id": "new-york-fed-reverse-repo-results",
      "authority": "Federal Reserve Bank of New York",
      "url": "https://www.newyorkfed.org/markets/desk-operations/reverse-repo",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "The New York Fed reports reverse-repo operation results and links its Markets Data APIs."
    },
    {
      "id": "white-house-presidential-actions",
      "authority": "The White House",
      "url": "https://www.whitehouse.gov/presidential-actions/",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-23",
      "supports": "The official Presidential Actions index publishes dated executive actions, memoranda, proclamations, and related actions. The adapter retains only normalized title, publication time, and direct URL in memory; the standalone Board renders a source label instead of an outbound URL."
    },
    {
      "id": "official-macro-event-calendars",
      "authority": "Federal Reserve, BLS, BEA, S&P Global, U.S. Treasury, and ECB",
      "url": "direct-source-list",
      "discovery": "public_web_search_then_direct_open",
      "opened_at": "2026-07-24",
      "supports": "Each retained event family has a direct calendar source. The adapter admits only allowlisted categories and bounded metadata from a direct source opened in the current run."
    }
  ],
  "excluded_fields": [
    {
      "field_id": "credit.hyg_close",
      "reason": "No direct stable source contract was opened for the exact completed close; configured-broker routing is not a Mars 1.0 assumption."
    },
    {
      "field_id": "credit.lqd_close",
      "reason": "No direct stable source contract was opened for the exact completed close; configured-broker routing is not a Mars 1.0 assumption."
    },
    {
      "field_id": "equity.spx_close",
      "reason": "No direct stable source contract was opened for the exact completed close."
    }
  ],
  "market_session": {
    "source_id": "us_equities_session",
    "source_url": "https://www.nyse.com/markets/hours-calendars",
    "source_timing": "completed_market",
    "latest_session_key": "latest_completed_market_session",
    "status_key": "session_state",
    "required_status": "completed",
    "raw_field_path": ["latest_completed_market_session"]
  },
  "event_contract": {
    "field_id": "events.seven_day_allowlist",
    "source_id": "official_macro_event_allowlist",
    "source_url": "multi_direct_sources",
    "source_timing": "event",
    "unit": "event_set",
    "raw_field_path": ["event_sources", "records"],
    "allowed_categories": ["fomc", "cpi", "employment", "gdp", "pmi", "long_duration_treasury_auction", "major_central_bank"],
    "source_ids": ["federal_reserve_event_calendar", "bls_release_schedule", "bea_release_schedule", "sp_global_pmi_calendar", "us_treasury_auction_calendar", "ecb_meeting_calendar"]
  },
  "event_sources": [
    {"source_id":"federal_reserve_event_calendar","source_url":"https://www.federalreserve.gov/newsevents/calendar.htm","allowed_categories":["fomc"]},
    {"source_id":"bls_release_schedule","source_url":"https://www.bls.gov/schedule/","allowed_categories":["cpi","employment"]},
    {"source_id":"bea_release_schedule","source_url":"https://www.bea.gov/news/schedule","allowed_categories":["gdp"]},
    {"source_id":"sp_global_pmi_calendar","source_url":"https://www.pmi.spglobal.com/Public/Home/PressRelease","allowed_categories":["pmi"]},
    {"source_id":"us_treasury_auction_calendar","source_url":"https://home.treasury.gov/resource-center/data-chart-center/quarterly-refunding/treasury-auction-schedules","allowed_categories":["long_duration_treasury_auction"]},
    {"source_id":"ecb_meeting_calendar","source_url":"https://www.ecb.europa.eu/press/calendars/mgcgc/html/index.en.html","allowed_categories":["major_central_bank"]}
  ],
  "fields": [
    {"field_id":"rates.us_2y_yield","source_id":"us_treasury_daily_rates","source_url":"https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve","source_timing":"completed_market","unit":"percent","collection_key":"records","date_key":"date","value_key":"2 Yr","raw_field_path":["records","$last","2 Yr"]},
    {"field_id":"rates.us_10y_yield","source_id":"us_treasury_daily_rates","source_url":"https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve","source_timing":"completed_market","unit":"percent","collection_key":"records","date_key":"date","value_key":"10 Yr","raw_field_path":["records","$last","10 Yr"]},
    {"field_id":"rates.us_30y_yield","source_id":"us_treasury_daily_rates","source_url":"https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve","source_timing":"completed_market","unit":"percent","collection_key":"records","date_key":"date","value_key":"30 Yr","raw_field_path":["records","$last","30 Yr"]},
    {"field_id":"volatility.vix_close","source_id":"cboe_vix_history","source_url":"https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv","source_timing":"completed_market","unit":"volatility_index_points","collection_key":"records","date_key":"DATE","value_key":"CLOSE","raw_field_path":["records","$last","CLOSE"]},
    {"field_id":"volatility.vix3m_close","source_id":"cboe_vix3m_history","source_url":"https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX3M_History.csv","source_timing":"completed_market","unit":"volatility_index_points","collection_key":"records","date_key":"DATE","value_key":"CLOSE","raw_field_path":["records","$last","CLOSE"]},
    {"field_id":"equity.ndx_close","source_id":"fred_nasdaq100_history","source_url":"https://fred.stlouisfed.org/graph/fredgraph.csv?id=NASDAQ100","source_timing":"completed_market","unit":"index_points","collection_key":"records","date_key":"DATE","value_key":"NASDAQ100","raw_field_path":["records","$last","NASDAQ100"]},
    {"field_id":"equity.rut_close","source_id":"cboe_rut_history","source_url":"https://cdn.cboe.com/api/global/us_indices/daily_prices/RUT_History.csv","source_timing":"completed_market","unit":"index_points","collection_key":"records","date_key":"DATE","value_key":"RUT","raw_field_path":["records","$last","RUT"]},
    {"field_id":"liquidity.reserve_balances","source_id":"federal_reserve_h41","source_url":"https://www.federalreserve.gov/releases/h41/","source_timing":"official_release","unit":"usd_billions","collection_key":"releases","date_key":"reference_period","value_key":"reserve_balances_billions","raw_field_path":["releases","$last","reserve_balances_billions"]},
    {"field_id":"liquidity.tga_balance","source_id":"us_treasury_dts","source_url":"https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v1/accounting/dts/operating_cash_balance","source_timing":"official_release","unit":"usd_billions","collection_key":"records","date_key":"record_date","value_key":"open_today_bal","scale":0.001,"filter":{"key":"account_type","equals":"Treasury General Account (TGA) Closing Balance"},"raw_field_path":["records","account_type=Treasury General Account (TGA) Closing Balance","$last","open_today_bal"]},
    {"field_id":"liquidity.on_rrp_usage","source_id":"new_york_fed_on_rrp","source_url":"https://www.newyorkfed.org/markets/desk-operations/reverse-repo","source_timing":"official_release","unit":"usd_billions","collection_key":"results","date_key":"operation_date","value_key":"accepted_amount_billions","filter":{"key":"operation_type","equals":"Overnight Reverse Repo"},"raw_field_path":["results","operation_type=Overnight Reverse Repo","$last","accepted_amount_billions"]},
    {"field_id":"policy.us_executive_actions","source_id":"white_house_presidential_actions","source_url":"https://www.whitehouse.gov/presidential-actions/","source_timing":"policy","unit":"policy_evidence_set","collection_key":"records","date_key":"published_at","value_key":"title","raw_field_path":["records"]}
  ]
}
