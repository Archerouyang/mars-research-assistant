  "forbidden_effects": [
    "trade_recommendation",
    "position_sizing",
    "technical_analysis",
    "account_access",
    "broker_write",
    "drive_write",
    "persistent_state"
  ],
  "scenarios": [
    {
      "request": "为 NVDA 做一份深度研究和估值。",
      "expected": {
        "research_as_of": "included",
        "issuer_identity": "verified",
        "nine_chapter_report": "included",
        "financial_quality_checks": "four_checks_with_sources_or_gaps",
        "valuation_status": "run_only_when_input_contract_is_met",
        "sources_and_timestamps": "included",
        "data_gap": "included",
        "local_artifact": "markdown_created"
      }
    }
  ]
