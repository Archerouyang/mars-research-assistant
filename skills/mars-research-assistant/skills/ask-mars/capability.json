{
  "schema_version": 1,
  "skill": "ask-mars",
  "delivery": "local_markdown_recommendation",
  "default_market": {
    "when_unspecified": "US equities",
    "currency": "USD",
    "timezone": "America/New_York",
    "user_timezone_does_not_select_market": true,
    "explicit_market_overrides": true
  },
  "response_fields": [
    "recommended_skills",
    "first_step",
    "minimum_input",
    "assumptions",
    "quick_replies",
    "local_artifact"
  ],
  "forbidden_effects": [
    "research",
    "market_data",
    "drive_write"
  ],
  "scenarios": [
    {
      "request": "帮我准备下周美股事件，并研究 NVDA。",
      "expected": {
        "recommended_skills": [
          "市场催化剂简报",
          "个股快览"
        ],
        "sequence": [
          "市场催化剂简报",
          "个股快览"
        ],
        "first_step": "市场催化剂简报",
        "minimum_input": [],
        "assumptions": {
          "market": "US equities",
          "currency": "USD",
          "timezone": "America/New_York",
          "catalyst_window": "next week"
        },
        "quick_replies": [
          "开始市场催化剂简报",
          "调整研究范围"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "分析 NVDA 日线趋势、关键位并给我一张可审计图表。",
      "expected": {
        "recommended_skills": [
          "技术面分析"
        ],
        "first_step": "技术面分析",
        "minimum_input": [
          "新的 output_dir"
        ],
        "assumptions": {
          "market": "US equities",
          "currency": "USD",
          "timezone": "America/New_York",
          "timeframe": "1D"
        },
        "quick_replies": [
          "提供 output_dir",
          "先看市场快照"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "/ask mars",
      "expected": {
        "recommended_skills": [
          "市场快照",
          "市场催化剂简报"
        ],
        "sequence": [
          "市场快照",
          "市场催化剂简报"
        ],
        "first_step": "市场快照",
        "minimum_input": [],
        "assumptions": {
          "market": "US equities",
          "currency": "USD",
          "timezone": "America/New_York",
          "catalyst_window": "next 7 calendar days"
        },
        "quick_replies": [
          "开始",
          "只看市场快照",
          "添加 ticker"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "开始今天的交易研究",
      "expected": {
        "recommended_skills": [
          "市场快照",
          "市场催化剂简报"
        ],
        "sequence": [
          "市场快照",
          "市场催化剂简报"
        ],
        "first_step": "市场快照",
        "minimum_input": [],
        "assumptions": {
          "market": "US equities",
          "currency": "USD",
          "timezone": "America/New_York",
          "catalyst_window": "next 7 calendar days"
        },
        "quick_replies": [
          "开始",
          "只看市场快照",
          "添加 ticker"
        ],
        "local_artifact": "markdown_created"
      }
    }
  ]
}
