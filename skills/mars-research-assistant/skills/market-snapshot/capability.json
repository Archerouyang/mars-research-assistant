{
  "schema_version": 1,
  "skill": "market-snapshot",
  "delivery": "local_markdown_snapshot",
  "local_artifact_contract": {
    "directory": "mars-research",
    "format": "markdown",
    "unique_name_required": true,
    "overwrite": "forbidden"
  },
  "default_market": {
    "when_unspecified": "US equities",
    "currency": "USD",
    "timezone": "America/New_York",
    "user_timezone_does_not_select_market": true,
    "explicit_market_overrides": true
  },
  "explicit_request_required": true,
  "response_fields": [
    "research_as_of",
    "current_state",
    "core_indicators",
    "scenario_triggers",
    "risk_exposure",
    "data_gap",
    "local_artifact"
  ],
  "forbidden_effects": [
    "account_access",
    "broker_write",
    "drive_write",
    "persistent_state"
  ],
  "baseline_indicator_groups": [
    "利率与通胀：2Y、10Y、30Y、CPI、核心 CPI、PPI",
    "风险偏好与信用：VIX、VIX3M、HYG/LQD",
    "美元与大宗商品：DXY、WTI 原油、黄金"
  ],
  "required_contract": {
    "delivery": "local_markdown_snapshot",
    "explicit_request_required": true
  },
  "scenarios": [
    {
      "request": "给我一份当前美股宏观与风险偏好的市场快照。",
      "expected": {
        "research_as_of": "included",
        "current_state": "included",
        "core_indicators": "included",
        "scenario_triggers": "included",
        "risk_exposure": "included",
        "data_gap": "included",
        "local_artifact": "markdown_created"
      }
    }
  ]
}
